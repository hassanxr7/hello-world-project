{
  "name": "afuufow",
  "productName": "Afuufow",
  "version": "0.1.0",
  "description": "Afuufow - Somali-speaking Windows desktop AI assistant for Hassan Mohamed Mohamud (Boss Hassan XR)",
  "author": "Hassan Mohamed Mohamud",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "eval:speech": "node scripts/build-main.mjs --eval && node dist/eval/eval-speech.js",
    "icons": "electron scripts/make-icons.cjs",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "dist:win:ci": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vladmandic/human": "3.3.6",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "playwright-core": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hassanxr7/hello-world-project.git",
    "directory": "afuufow"
  },
  "homepage": "https://github.com/hassanxr7/hello-world-project/tree/main/afuufow"
}
