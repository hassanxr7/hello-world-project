# Copy to fx-ai-trader/.env (git-ignored) or set as OS environment variables. Never commit real values.

# Dashboard login: generate with `python -m fxai hash-password`
FXAI_DASHBOARD_PASSWORD_HASH=
# Session signing key: generate with `python -m fxai gen-secret` (>= 32 characters)
FXAI_SECRET_KEY=

# Optional: only if llm.mode is advisory/veto. Alternatively use `ant auth login`.
ANTHROPIC_API_KEY=

# Optional: path to the config file (default config/config.yaml)
# FXAI_CONFIG=config/config.yaml
